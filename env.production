# Variables de entorno para producción
# Este archivo se usa durante el build para que Next.js embeba las URLs correctas
NODE_ENV=production

# URLs de la aplicación en producción
NEXT_PUBLIC_APP_URL=https://portfolio-ecomerce.shop
NEXT_PUBLIC_BACKEND_API_BASE_URL=https://portfolio-ecomerce.shop/api/v1
NEXT_PUBLIC_API_URL=https://portfolio-ecomerce.shop/api/v1

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=543813571707

# Configuración de Next.js
NEXT_TELEMETRY_DISABLED=1
PORT=3000

# Configuración de seguridad
NEXT_PUBLIC_APP_ENV=production

# IMPORTANTE: Este archivo debe estar presente ANTES del build
# para que Next.js compile el frontend con las URLs de producción
# Si no está, Next.js usará las URLs de desarrollo (localhost)
